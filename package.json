{
	"name": "pairwise-tui",
	"description": "Terminal UI for pairwise and combinatorial test case generation with Microsoft PICT",
	"homepage": "https://radekbednarik.github.io/pairwise-tui/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radekBednarik/pairwise-tui.git"
	},
	"bugs": {
		"url": "https://github.com/radekBednarik/pairwise-tui/issues"
	},
	"keywords": [
		"pairwise-testing",
		"combinatorial-testing",
		"pict",
		"test-case-generator",
		"testing-tool",
		"terminal-ui",
		"qa",
		"tui"
	],
	"license": "MIT",
	"author": "Radek Bednarik",
	"module": "src/index.tsx",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/index.tsx",
		"build:dist": "bun run build:dist:linux && bun run build:dist:windows",
		"build:dist:linux": "bun scripts/build-linux.ts",
		"build:dist:windows": "bun scripts/build-windows.ts",
		"package:appimage": "bun scripts/package-appimage.ts",
		"start": "bun src/index.tsx",
		"check": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/bun": "latest",
		"@types/react": "^19.2.14",
		"skills": "^1.4.5"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.81.0",
		"@opentui/core": "^0.1.88",
		"@opentui/react": "^0.1.88",
		"react": "^19.2.4",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	}
}
